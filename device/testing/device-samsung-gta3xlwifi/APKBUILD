# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-samsung-gta3xlwifi
pkgdesc="Samsung Galaxy Tab A"
pkgver=1
pkgrel=37
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
# The Mesa fork carries the Mali-G71 derivative fix (gpu-dev TEX-001). Keep
# it from being replaced by the repositories' Mesa, which GNOME Software's
# updater (apk upgrade --available) would otherwise do. The same goes for
# the libcamera fork, which adds the CSIS and S5K4HA/S5K5E9 support.
depends="
	linux-samsung-gta3xlwifi
	libcamera>=99990.7.2-r100
	mesa>=26.3.0_git20261014-r3
	mesa-dri-gallium
	mesa-vulkan-panfrost
	postmarketos-base
	mkbootimg
	libcap-getcap
	libcap-setcap
	networkmanager
	networkmanager-cli
	bluez
	util-linux-misc
	iio-sensor-proxy
	py3-gobject3
	xinput
	xrandr
"
# The systemd units used to be in a -systemd subpackage pulled in through
# install_if; apk upgrade --available removes such packages because no
# repository carries them. Units are inert on OpenRC.
replaces="$pkgname-systemd"
makedepends="devicepkg-dev"
triggers="$pkgname.trigger=/usr/bin"
source="
	deviceinfo
	90-gta3xlwifi-networkmanager.conf
	gta3xlwifi-wifibt.sh
	gta3xlwifi-wifibt-networkmanager.sh
	wifibt.initd
	wifibt-networkmanager.initd
	gta3xlwifi-wifibt.service
	gta3xlwifi-wifibt-networkmanager.service
	80-device-samsung-gta3xlwifi.preset
	gta3xlwifi-kwin-rt.sh
	gta3xlwifi-kwin-rt.service
	gta3xlwifi-kwin-rt.start
	gta3xlwifi-rtprio.conf
	gta3xlwifi-rtprio-limits.conf
	device-samsung-gta3xlwifi.trigger
	gta3xlwifi-audio-modprobe.conf
	gta3xlwifi-audio-modules.conf
	gta3xlwifi-ucm.conf
	gta3xlwifi-ucm-HiFi.conf
	gta3xlwifi-panvk.sh
	gta3xlwifi-graphics.sh
	90_device-samsung-gta3xlwifi.gschema.override
	gta3xlwifi-display-modules.conf
	gta3xlwifi-xorg-dpu.conf
	gta3xlwifi-autorotate
	gta3xlwifi-autorotate.desktop
	gta3xlwifi-rotation-lock.desktop
	device-samsung-gta3xlwifi-openrc.post-install
	device-samsung-gta3xlwifi-openrc.post-upgrade
	device-samsung-gta3xlwifi-openrc.pre-deinstall
"
subpackages="$pkgname-openrc $pkgname-nonfree-firmware:nonfree_firmware"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm644 "$srcdir/90-gta3xlwifi-networkmanager.conf" \
		"$pkgdir/etc/NetworkManager/conf.d/90-gta3xlwifi.conf"
	install -Dm755 "$srcdir/gta3xlwifi-wifibt.sh" \
		"$pkgdir/usr/libexec/gta3xlwifi/wifibt"
	install -Dm755 "$srcdir/gta3xlwifi-wifibt-networkmanager.sh" \
		"$pkgdir/usr/libexec/gta3xlwifi/wifibt-networkmanager"
	install -Dm755 "$srcdir/gta3xlwifi-kwin-rt.sh" \
		"$pkgdir/usr/libexec/gta3xlwifi/kwin-rt"
	install -Dm644 "$srcdir/gta3xlwifi-wifibt.service" \
		"$srcdir/gta3xlwifi-wifibt-networkmanager.service" \
		"$srcdir/gta3xlwifi-kwin-rt.service" \
		-t "$pkgdir/usr/lib/systemd/system"
	install -Dm644 "$srcdir/80-device-samsung-gta3xlwifi.preset" \
		-t "$pkgdir/usr/lib/systemd/system-preset"
	# Real-time priority for KWin's threads without CAP_SYS_NICE
	install -Dm644 "$srcdir/gta3xlwifi-rtprio.conf" \
		"$pkgdir/usr/lib/systemd/system/user@.service.d/gta3xlwifi-rtprio.conf"
	install -Dm644 "$srcdir/gta3xlwifi-audio-modprobe.conf" \
		"$pkgdir/etc/modprobe.d/gta3xlwifi-audio.conf"
	install -Dm644 "$srcdir/gta3xlwifi-audio-modules.conf" \
		"$pkgdir/usr/lib/modules-load.d/gta3xlwifi-audio.conf"
	install -Dm644 "$srcdir/gta3xlwifi-ucm.conf" \
		"$pkgdir/usr/share/alsa/ucm2/Samsung/gta3xlwifi/gta3xlwifi.conf"
	install -Dm644 "$srcdir/gta3xlwifi-ucm-HiFi.conf" \
		"$pkgdir/usr/share/alsa/ucm2/Samsung/gta3xlwifi/HiFi.conf"
	mkdir -p "$pkgdir/usr/share/alsa/ucm2/conf.d/gta3xlwifi"
	ln -s ../../Samsung/gta3xlwifi/gta3xlwifi.conf \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/gta3xlwifi/gta3xlwifi.conf"
	install -Dm644 "$srcdir/gta3xlwifi-panvk.sh" \
		"$pkgdir/etc/profile.d/gta3xlwifi-panvk.sh"
	install -Dm644 "$srcdir/gta3xlwifi-graphics.sh" \
		"$pkgdir/etc/profile.d/gta3xlwifi-graphics.sh"
	install -Dm644 "$srcdir/90_device-samsung-gta3xlwifi.gschema.override" \
		-t "$pkgdir/usr/share/glib-2.0/schemas"
	install -Dm644 "$srcdir/gta3xlwifi-display-modules.conf" \
		"$pkgdir/usr/lib/modules-load.d/gta3xlwifi-display.conf"
	install -Dm644 "$srcdir/gta3xlwifi-xorg-dpu.conf" \
		"$pkgdir/usr/share/X11/xorg.conf.d/10-exynos7885-dpu.conf"
	# Accelerometer screen rotation for XFCE (X11), via iio-sensor-proxy
	install -Dm755 "$srcdir/gta3xlwifi-autorotate" \
		"$pkgdir/usr/bin/gta3xlwifi-autorotate"
	install -Dm644 "$srcdir/gta3xlwifi-autorotate.desktop" \
		"$pkgdir/etc/xdg/autostart/gta3xlwifi-autorotate.desktop"
	install -Dm644 "$srcdir/gta3xlwifi-rotation-lock.desktop" \
		"$pkgdir/usr/share/applications/gta3xlwifi-rotation-lock.desktop"
}

openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	install="$subpkgname.post-install $subpkgname.post-upgrade $subpkgname.pre-deinstall"
	depends="openrc networkmanager networkmanager-cli bluez util-linux-misc"
	install -Dm755 "$srcdir/wifibt.initd" "$subpkgdir/etc/init.d/wifibt"
	install -Dm755 "$srcdir/wifibt-networkmanager.initd" \
		"$subpkgdir/etc/init.d/wifibt-networkmanager"
	install -Dm755 "$srcdir/gta3xlwifi-kwin-rt.start" \
		"$subpkgdir/etc/local.d/gta3xlwifi-kwin-rt.start"
	install -Dm644 "$srcdir/gta3xlwifi-rtprio-limits.conf" \
		"$subpkgdir/etc/security/limits.d/90-gta3xlwifi-rtprio.conf"
}


nonfree_firmware() {
	pkgdesc="Samsung gta3xlwifi nonfree firmware"
	depends="firmware-samsung-gta3xlwifi"
	mkdir "$subpkgdir"
}

