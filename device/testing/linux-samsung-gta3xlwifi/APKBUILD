# Reference: <https://postmarketos.org/vendorkernel>
# Kernel config based on: arch/arm64/configs/pmos-a30_defconfig

pkgname=linux-samsung-gta3xlwifi
pkgver=6.15
pkgrel=85
pkgdesc="Samsung Galaxy Tab A with close to mainline kernel"
arch="aarch64"
_carch="arm64"
_flavor="samsung-gta3xlwifi"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bash
	bc
	bison
	flex
	kmod
	openssl-dev
	perl
	postmarketos-installkernel
	python3
	xz
	unzip
"

# Source
_owner="Mollomm1"
_repository="linux-exynos7885"
_commit="fc00f9f2fad40220e00073549b8c1ff10a01cdad"

# Device specific
_config="config-$_flavor.$arch"
_dts="exynos7904-t510"

source="
	$pkgname-$_commit.tar.gz::https://github.com/$_owner/$_repository/archive/$_commit.tar.gz
	uniLoader.zip::https://github.com/Mollomm1/uniLoader/archive/refs/heads/main.zip
	$_config
	$_dts.dts
"
builddir="$srcdir/$_repository-$_commit"
uniloaderdir="$srcdir/uniLoader-main"
_outdir="out"

prepare() 
{
	default_prepare
	
	# Add our defconfig
	cp "$srcdir/$_config" .config
	
	# Add dts to the repo, and add it to the Makefile
	cp "$srcdir/$_dts.dts" "$builddir/arch/arm64/boot/dts/exynos/"
	sed -i "s/exynos7884b-a10.dtb/$_dts.dtb/" "$builddir/arch/arm64/boot/dts/exynos/Makefile"
}

build() {
	# Linux Kernel
	unset LDFLAGS
	make ARCH=arm64 CC="${CC:-gcc}" prepare
	make ARCH=arm64 CC="${CC:-gcc}" modules_prepare
	make ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-postmarketOS"

	# Preserve the exact source and complete output before abuild cleans it.
	# This host-side archive is not installed on the tablet.
	python3 tools/scsc-dev/scsc-dev.py capture \
		--baseline "$builddir" --commit "$_commit" \
		--cc "${CC:-gcc}" --cross-compile "${CROSS_COMPILE:-}" \
		--archive "${SRCDEST:?}/gta3xl-wifi-baseline-$_commit-r$pkgrel.tar.gz"
	
	# Uniloader
	cd "$uniloaderdir"
	touch blob/ramdisk
	cp "$builddir/arch/$_carch/boot/Image" blob/Image
	cp "$builddir/arch/$_carch/boot/dts/exynos/exynos7904-t510.dtb" blob/dtb
	test -s blob/Image
	test -s blob/dtb
	make ARCH="$arch" CC="${CC:-gcc}" t510_defconfig
	# NOTE: generate linker.lds serially first. The top-level 'all'
	# target builds arch/$arch/linker.lds in parallel with the link
	# step without an ordering dependency, so with -j the link can
	# read a half-written script (undefined _stack_end/dtb/kernel/
	# ramdisk). Pre-building it makes the parallel build deterministic.
	make ARCH="$arch" CC="${CC:-gcc}" "arch/$arch/linker.lds"
	make ARCH="$arch" CC="${CC:-gcc}"
}

package() {
	mkdir -p "$pkgdir/boot" "$pkgdir/lib/modules"
	install -Dm644 "$builddir/scsc-baseline.json" \
		"$pkgdir/usr/share/scsc-dev/baseline.json"
	# Disable alias autoload; the device boot service loads ACPM in order.
	mkdir -p "$pkgdir/etc/modprobe.d"
	printf '%s\n' \
		'blacklist exynos7885_acpm_mbox' \
		'blacklist acpm_protocol' \
		> "$pkgdir/etc/modprobe.d/scsc-development.conf"
	printf '%s\n' 'options exynos_scsc_wifibt enable=1' \
		> "$pkgdir/etc/modprobe.d/scsc-wifibt.conf"

	# The bootloader does not support zipped kernels
	make install modules_install dtbs_install \
		ARCH="$_carch" \
		INSTALL_PATH="$pkgdir/boot" \
		INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir/boot/dtbs"
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir/include/config/kernel.release" \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"

	install -Dm644 "$uniloaderdir/uniLoader" \
		"$pkgdir/boot/vmlinuz"
}

