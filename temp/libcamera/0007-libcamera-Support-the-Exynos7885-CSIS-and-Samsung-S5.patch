From: Mollomm1 <68751598+Mollomm1@users.noreply.github.com>
Date: Fri, 16 Oct 2026 16:57:30 +0200
Subject: [PATCH] libcamera: Support the Exynos7885 CSIS and Samsung
 S5K4HA/S5K5E9

The Samsung Galaxy Tab A 10.1 (2019, SM-T510) captures raw Bayer frames
through the CSIS v5 receivers of its Exynos7885 SoC (kernel driver
exynos7885-csis), from an S5K4HA rear and an S5K5E9 front sensor.

- simple: handle exynos7885-csis with the software ISP.
- Add sensor helpers: linear analogue gain with 0x20 = 1x and a black
  level of 64 at 10 bits, measured on the device.
- Add sensor properties: 1.12 um pixels and the CCS test patterns the
  s5k-smia kernel driver exposes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/ipa/libipa/camera_sensor_helper.cpp       | 24 ++++++++++++++
 src/libcamera/pipeline/simple/simple.cpp      |  1 +
 .../sensor/camera_sensor_properties.cpp       | 32 +++++++++++++++++++
 3 files changed, 57 insertions(+)

diff --git a/src/ipa/libipa/camera_sensor_helper.cpp b/src/ipa/libipa/camera_sensor_helper.cpp
index bb95700..bece515 100644
--- a/src/ipa/libipa/camera_sensor_helper.cpp
+++ b/src/ipa/libipa/camera_sensor_helper.cpp
@@ -839,6 +839,30 @@ public:
 };
 REGISTER_CAMERA_SENSOR_HELPER("ov13858", CameraSensorHelperOv13858)
 
+class CameraSensorHelperS5k4ha : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperS5k4ha()
+	{
+		/* Measured: 64 at 10 bits. */
+		blackLevel_ = 4096;
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 32 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("s5k4ha", CameraSensorHelperS5k4ha)
+
+class CameraSensorHelperS5k5e9 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperS5k5e9()
+	{
+		/* Measured: 64 at 10 bits. */
+		blackLevel_ = 4096;
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 32 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("s5k5e9", CameraSensorHelperS5k5e9)
+
 class CameraSensorHelperVd55g1 : public CameraSensorHelper
 {
 public:
