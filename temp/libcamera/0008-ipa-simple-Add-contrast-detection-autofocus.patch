@@ -0,0 +1,82 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Mollomm1
+ *
+ * Contrast detection autofocus
+ */
+
+#pragma once
+
+#include <libcamera/control_ids.h>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	Af() = default;
+	~Af() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context,
+		      const IPAConfigInfo &configInfo) override;
+	void queueRequest(IPAContext &context,
+			  const uint32_t frame,
+			  IPAFrameContext &frameContext,
+			  const ControlList &controls) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	enum class Phase {
+		Coarse,
+		Fine,
+	};
+
+	void moveTo(IPAContext &context, int32_t position);
+	void startScan(IPAContext &context);
+	void finishScan(IPAContext &context, controls::AfStateEnum state,
+			int32_t position);
+	void scanStep(IPAContext &context, double sharpness);
+	void monitor(IPAContext &context, double sharpness, double luma);
+
+	float toDioptres(int32_t position) const;
+	int32_t fromDioptres(float dioptres) const;
+
+	bool enabled_ = false;
+
+	/* Lens positions focused at infinity and at the closest distance */
+	int32_t infinity_ = 0;
+	int32_t macro_ = 0;
+	float macroDioptres_ = 0.0f;
+	int32_t coarseStep_ = 1;
+	int32_t fineStep_ = 1;
+
+	controls::AfModeEnum mode_ = controls::AfModeContinuous;
+	Phase phase_ = Phase::Coarse;
+	int32_t coarseBest_ = 0;
+	int32_t fineEnd_ = 0;
+	int32_t bestPosition_ = 0;
+	double bestSharpness_ = 0.0;
+	double worstSharpness_ = 0.0;
+
+	/* Statistics to ignore while the lens or the exposure settles */
+	unsigned int skip_ = 0;
+
+	double refSharpness_ = 0.0;
+	double lastLuma_ = 0.0;
+	unsigned int changed_ = 0;
+
+	double lastExposure_ = 0.0;
+	unsigned int exposureStable_ = 0;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
