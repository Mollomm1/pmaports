diff --git a/src/ipa/simple/algorithms/af.cpp b/src/ipa/simple/algorithms/af.cpp
new file mode 100644
index 0000000..c2b631d
--- /dev/null
+++ b/src/ipa/simple/algorithms/af.cpp
@@ -0,0 +1,343 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Mollomm1
+ *
+ * Contrast detection autofocus
+ */
+
+#include "af.h"
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+
+#include <linux/v4l2-controls.h>
+
+#include <libcamera/base/log.h>
+
+#include "libcamera/internal/software_isp/swisp_stats.h"
+
+/**
+ * \file af.h
+ */
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+/**
+ * \class Af
+ * \brief Contrast detection autofocus for a voice coil lens
+ *
+ * The software ISP statistics measure the sharpness of the centre of the
+ * image. A scan steps the lens from infinity towards macro in coarse steps
+ * until the sharpness has clearly passed its peak, then refines around the
+ * best position with fine steps and settles on the sharpest one. A scene
+ * whose sharpness hardly varies with the lens position fails the scan and
+ * leaves the lens at infinity.
+ *
+ * In continuous mode, a sustained change of the sharpness at a stable
+ * exposure starts a new scan.
+ *
+ * Noise grows with the analogue gain and inflates the sharpness, so the
+ * algorithm only measures while the AGC leaves exposure and gain alone. A scan
+ * pauses until the AGC settles.
+ *
+ * The tuning data may set the lens positions focused at infinity and at the
+ * closest distance (\a infinity and \a macro, defaulting to the lens control
+ * range), the dioptres at the closest distance (\a macroDioptres) and the scan
+ * steps (\a coarseStep and \a fineStep).
+ */
+
+LOG_DEFINE_CATEGORY(IPASoftAf)
+
+/* Sharpness below this fraction of the best one is past the peak. */
+static constexpr double kPeakDrop = 0.75;
+/* The best sharpness must exceed the worst one by this factor. */
+static constexpr double kMinContrast = 1.15;
+/* Relative sharpness change that suggests a new scene */
+static constexpr double kSceneChange = 0.35;
+/* Number of consecutive changed measurements that start a scan */
+static constexpr unsigned int kSceneChangeCount = 3;
+/* Relative brightness change that marks a settling exposure */
+static constexpr double kLumaTolerance = 0.1;
+/* Statistics to skip at start while the exposure settles */
+static constexpr unsigned int kStartSkip = 2;
+/* Relative exposure x gain change that counts as an AGC adjustment */
+static constexpr double kExposureTolerance = 0.02;
+/* Unchanged AGC outputs needed before the sharpness can be trusted */
+static constexpr unsigned int kExposureStableCount = 2;
+
+int Af::init(IPAContext &context, const ValueNode &tuningData)
+{
+	auto it = context.lensControls.find(V4L2_CID_FOCUS_ABSOLUTE);
+	if (it == context.lensControls.end()) {
+		LOG(IPASoftAf, Debug) << "No focus lens, autofocus disabled";
+		return 0;
+	}
+
+	int32_t min = it->second.min().get<int32_t>();
+	int32_t max = it->second.max().get<int32_t>();
+
+	infinity_ = std::clamp(tuningData["infinity"].get<int32_t>(min), min, max);
+	macro_ = std::clamp(tuningData["macro"].get<int32_t>(max), min, max);
+	if (macro_ <= infinity_) {
+		LOG(IPASoftAf, Error)
+			<< "Invalid lens range " << infinity_ << "-" << macro_;
+		return -EINVAL;
+	}
+
+	macroDioptres_ = tuningData["macroDioptres"].get<float>(10.0f);
+	coarseStep_ = std::max(tuningData["coarseStep"].get<int32_t>((macro_ - infinity_) / 16), 1);
+	fineStep_ = std::max(tuningData["fineStep"].get<int32_t>(coarseStep_ / 4), 1);
+
+	context.ctrlMap[&controls::AfMode] =
+		ControlInfo(controls::AfModeValues,
+			    ControlValue(static_cast<int32_t>(controls::AfModeContinuous)));
+	context.ctrlMap[&controls::AfTrigger] =
+		ControlInfo(controls::AfTriggerValues);
+	context.ctrlMap[&controls::LensPosition] =
+		ControlInfo(0.0f, macroDioptres_, 0.0f);
+
+	enabled_ = true;
+
+	LOG(IPASoftAf, Debug)
+		<< "Lens " << infinity_ << "-" << macro_ << ", steps "
+		<< coarseStep_ << "/" << fineStep_;
+
+	return 0;
+}
+
+int Af::configure(IPAContext &context,
+		  [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	auto &af = context.activeState.af;
+
+	af.state = controls::AfStateIdle;
+	af.moved = false;
+	if (!enabled_)
+		return 0;
+
+	mode_ = controls::AfModeContinuous;
+
+	moveTo(context, infinity_);
+	skip_ = kStartSkip;
+	refSharpness_ = 0.0;
+	lastLuma_ = 0.0;
+	changed_ = 0;
+	lastExposure_ = 0.0;
+	exposureStable_ = 0;
+
+	if (mode_ == controls::AfModeContinuous)
+		startScan(context);
+
+	return 0;
+}
+
+void Af::queueRequest(IPAContext &context,
+		      [[maybe_unused]] const uint32_t frame,
+		      [[maybe_unused]] IPAFrameContext &frameContext,
+		      const ControlList &controls)
+{
+	if (!enabled_)
+		return;
+
+	auto &af = context.activeState.af;
+
+	const auto &mode = controls.get(controls::AfMode);
+	if (mode && *mode != mode_) {
+		mode_ = static_cast<controls::AfModeEnum>(*mode);
+		af.state = controls::AfStateIdle;
+		if (mode_ == controls::AfModeContinuous)
+			startScan(context);
+	}
+
+	const auto &trigger = controls.get(controls::AfTrigger);
+	if (trigger && mode_ == controls::AfModeAuto) {
+		if (*trigger == controls::AfTriggerStart)
+			startScan(context);
+		else if (af.state == controls::AfStateScanning)
+			af.state = controls::AfStateIdle;
+	}
+
+	const auto &lensPosition = controls.get(controls::LensPosition);
+	if (lensPosition && mode_ == controls::AfModeManual)
+		moveTo(context, fromDioptres(*lensPosition));
+}
+
+void Af::process(IPAContext &context,
+		 [[maybe_unused]] const uint32_t frame,
+		 IPAFrameContext &frameContext,
+		 const SwIspStats *stats,
+		 ControlList &metadata)
+{
+	if (!enabled_)
+		return;
+
+	auto &af = context.activeState.af;
+
+	if (stats->valid && stats->sum_.g()) {
+		double luma = stats->sum_.g();
+		/* Normalise, so that exposure and gain changes cancel out. */
+		double sharpness = stats->sharpness / (luma * luma);
+		/*
+		 * The AGC has already set the next exposure and gain here. They
+		 * reach the sensor within a statistics period, so two unchanged
+		 * outputs in a row mean that this frame and the previous one
+		 * were exposed alike.
+		 */
+		double exposure = frameContext.sensor.exposure * frameContext.sensor.gain;
+
+		if (std::abs(exposure - lastExposure_) <= kExposureTolerance * lastExposure_)
+			exposureStable_++;
+		else
+			exposureStable_ = 0;
+		lastExposure_ = exposure;
+
+		if (skip_)
+			skip_--;
+		else if (exposureStable_ < kExposureStableCount)
+			changed_ = 0;
+		else if (af.state == controls::AfStateScanning)
+			scanStep(context, sharpness);
+		else if (mode_ == controls::AfModeContinuous)
+			monitor(context, sharpness, luma);
+	}
+
+	metadata.set(controls::AfState, af.state);
+	metadata.set(controls::LensPosition, toDioptres(af.position));
+}
+
+void Af::moveTo(IPAContext &context, int32_t position)
+{
+	auto &af = context.activeState.af;
+
+	position = std::clamp(position, infinity_, macro_);
+
+	/* Give the lens a measurement to settle after a long move. */
+	if (std::abs(position - af.position) > 2 * coarseStep_)
+		skip_ = std::max(skip_, 1u);
+
+	af.position = position;
+	af.moved = true;
+}
+
+void Af::startScan(IPAContext &context)
+{
+	context.activeState.af.state = controls::AfStateScanning;
+	phase_ = Phase::Coarse;
+	bestSharpness_ = 0.0;
+	worstSharpness_ = std::numeric_limits<double>::max();
+	moveTo(context, infinity_);
+}
+
+void Af::finishScan(IPAContext &context, controls::AfStateEnum state,
+		    int32_t position)
+{
+	context.activeState.af.state = state;
+	moveTo(context, position);
+	refSharpness_ = 0.0;
+	lastLuma_ = 0.0;
+	changed_ = 0;
+
+	LOG(IPASoftAf, Debug)
+		<< (state == controls::AfStateFocused ? "Focused" : "Failed")
+		<< " at " << position << ", sharpness "
+		<< worstSharpness_ << "-" << bestSharpness_;
+}
+
+void Af::scanStep(IPAContext &context, double sharpness)
+{
+	int32_t position = context.activeState.af.position;
+
+	LOG(IPASoftAf, Debug)
+		<< "Position " << position << ": sharpness " << sharpness;
+
+	if (sharpness > bestSharpness_) {
+		bestSharpness_ = sharpness;
+		bestPosition_ = position;
+	}
+	worstSharpness_ = std::min(worstSharpness_, sharpness);
+
+	if (phase_ == Phase::Coarse) {
+		bool pastPeak = sharpness < kPeakDrop * bestSharpness_ &&
+				position >= bestPosition_ + 2 * coarseStep_;
+
+		if (!pastPeak && position < macro_) {
+			moveTo(context, position + coarseStep_);
+			return;
+		}
+
+		if (bestSharpness_ < kMinContrast * worstSharpness_) {
+			finishScan(context, controls::AfStateFailed, infinity_);
+			return;
+		}
+
+		phase_ = Phase::Fine;
+		coarseBest_ = bestPosition_;
+		fineEnd_ = std::min(coarseBest_ + coarseStep_ / 2, macro_);
+		moveTo(context, std::max(coarseBest_ - coarseStep_ / 2, infinity_));
+		return;
+	}
+
+	int32_t next = position + fineStep_;
+	/* The coarse scan has measured this one already. */
+	if (next == coarseBest_)
+		next += fineStep_;
+
+	if (next <= fineEnd_) {
+		moveTo(context, next);
+		return;
+	}
+
+	finishScan(context, controls::AfStateFocused, bestPosition_);
+}
+
+void Af::monitor(IPAContext &context, double sharpness, double luma)
+{
+	/* Judge the sharpness only once the exposure has settled. */
+	bool stable = lastLuma_ > 0.0 &&
+		      std::abs(luma - lastLuma_) < kLumaTolerance * lastLuma_;
+
+	lastLuma_ = luma;
+	if (!stable) {
+		changed_ = 0;
+		return;
+	}
+
+	if (refSharpness_ == 0.0) {
+		refSharpness_ = sharpness;
+		return;
+	}
+
+	if (std::abs(sharpness - refSharpness_) <= kSceneChange * refSharpness_) {
+		changed_ = 0;
+		return;
+	}
+
+	if (++changed_ < kSceneChangeCount)
+		return;
+
+	LOG(IPASoftAf, Debug)
+		<< "Sharpness changed from " << refSharpness_ << " to "
+		<< sharpness << ", rescanning";
+	startScan(context);
+}
+
+float Af::toDioptres(int32_t position) const
+{
+	return std::max(position - infinity_, 0) * macroDioptres_ /
+	       (macro_ - infinity_);
+}
+
+int32_t Af::fromDioptres(float dioptres) const
+{
+	return infinity_ +
+	       std::lround(dioptres * (macro_ - infinity_) / macroDioptres_);
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
